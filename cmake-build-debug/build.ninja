# =============================================================================
# Project: cpp_learning
# Configurations: Debug
# =============================================================================

#############################################
# Minimal version of Ninja required by this file

ninja_required_version = 1.5


#############################################
# Set configuration variable for custom commands.

CONFIGURATION = Debug
# =============================================================================
# Include auxiliary files.


#############################################
# Include rules file.

include CMakeFiles/rules.ninja

# =============================================================================

#############################################
# Logical path to working directory; prefix for absolute paths.

cmake_ninja_workdir = /Users/even/Desktop/even/code/cpp/cpp_learning/cmake-build-debug/
# =============================================================================
# Object build statements for EXECUTABLE target hello_world_main


#############################################
# Order-only phony target for hello_world_main

build cmake_object_order_depends_target_hello_world_main: phony || CMakeFiles/hello_world_main.dir

build CMakeFiles/hello_world_main.dir/main.cpp.o: CXX_COMPILER__hello_world_main_Debug /Users/even/Desktop/even/code/cpp/cpp_learning/main.cpp || cmake_object_order_depends_target_hello_world_main
  DEP_FILE = CMakeFiles/hello_world_main.dir/main.cpp.o.d
  FLAGS = -g -arch arm64 -isysroot /Library/Developer/CommandLineTools/SDKs/MacOSX15.0.sdk -std=gnu++14
  INCLUDES = -I/Users/even/Desktop/even/code/cpp/cpp_learning/math
  OBJECT_DIR = CMakeFiles/hello_world_main.dir
  OBJECT_FILE_DIR = CMakeFiles/hello_world_main.dir


# =============================================================================
# Link build statements for EXECUTABLE target hello_world_main


#############################################
# Link the executable hello_world_main

build hello_world_main: CXX_EXECUTABLE_LINKER__hello_world_main_Debug CMakeFiles/hello_world_main.dir/main.cpp.o
  FLAGS = -g -arch arm64 -isysroot /Library/Developer/CommandLineTools/SDKs/MacOSX15.0.sdk
  OBJECT_DIR = CMakeFiles/hello_world_main.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = hello_world_main
  TARGET_PDB = hello_world_main.dbg

